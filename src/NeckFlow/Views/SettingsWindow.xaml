<Window x:Class="NeckFlow.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NeckFlow Settings" Width="720" Height="540" MinWidth="640" MinHeight="480" WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBg}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,2"/><Setter Property="FontSize" Value="14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBg}"/></Trigger></Style.Triggers></Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource InputBg}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="10,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource InputBg}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="Padding" Value="10,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
      <ToggleButton x:Name="Toggle" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Focusable="False"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4"><Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
      <ContentPresenter Margin="{TemplateBinding Padding}" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" TextElement.Foreground="{DynamicResource TextBrush}"/>
      <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,2,8,8" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="3"><Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3"/></Border.Effect><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup>
    </Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,8"/></Style>
  </Window.Resources>
  <Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="NeckFlow" FontSize="26" FontWeight="Bold" Margin="0,0,0,5"/><TextBlock Text="Movement reminders" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,22"/><Button Content="General" Click="GeneralClick"/><Button Content="Schedule" Click="ScheduleClick"/><Button Content="Exercises" Click="ExercisesClick"/><Button Content="Appearance" Click="AppearanceClick"/><Button Content="About" Click="AboutClick"/></StackPanel>
    <ScrollViewer Grid.Column="1" Margin="32,0,0,0" VerticalScrollBarVisibility="Auto"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel x:Name="GeneralPanel"><TextBlock Text="General" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Control how NeckFlow fits into your day." Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,20"/><CheckBox x:Name="Startup" Content="Start NeckFlow when Windows starts"/><CheckBox x:Name="Paused" Content="Pause reminders"/><CheckBox x:Name="Sound" Content="Play notification sounds" ToolTip="Play a subtle sound when an exercise popup appears" AutomationProperties.Name="Play notification sounds"/><TextBlock Text="Reminder interval" Margin="0,20,0,5" FontWeight="SemiBold"/><ComboBox x:Name="Interval" SelectedValuePath="Tag" Width="190" HorizontalAlignment="Left"><ComboBoxItem Content="15 minutes" Tag="15"/><ComboBoxItem Content="20 minutes" Tag="20"/><ComboBoxItem Content="30 minutes" Tag="30"/><ComboBoxItem Content="45 minutes" Tag="45"/><ComboBoxItem Content="60 minutes" Tag="60"/><ComboBoxItem Content="90 minutes" Tag="90"/></ComboBox></StackPanel>
      <StackPanel x:Name="SchedulePanel" Visibility="Collapsed"><TextBlock Text="Schedule" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Reminders are only shown during these hours." Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,22"/><TextBlock Text="Active hours" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,8,0,12"><TextBox x:Name="ActiveStartText" Width="110" Padding="8"/><TextBlock Text="  to  " VerticalAlignment="Center"/><TextBox x:Name="ActiveEndText" Width="110" Padding="8"/></StackPanel><CheckBox x:Name="WeekdaysOnly" Content="Run on weekdays only"/><CheckBox x:Name="AvoidFullscreen" Content="Avoid reminders while a full-screen app is running"/></StackPanel>
      <StackPanel x:Name="ExercisesPanel" Visibility="Collapsed"><TextBlock Text="Exercises" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Your break rotates through these gentle movements." Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,22"/><ItemsControl ItemsSource="{Binding}"><ItemsControl.ItemTemplate><DataTemplate><Border x:Name="Row" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,10" Background="Transparent" Cursor="Hand" ToolTip="Click to preview this exercise" MouseLeftButtonUp="ExerciseRowClick"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="15" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding DurationSeconds, StringFormat={}{0} sec}" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/></Grid></Border><DataTemplate.Triggers><Trigger SourceName="Row" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBg}"/></Trigger></DataTemplate.Triggers></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
      <StackPanel x:Name="AppearancePanel" Visibility="Collapsed"><TextBlock Text="Appearance" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Keep the popup calm and easy to read." Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,22"/><TextBlock Text="Theme" FontWeight="SemiBold"/><ComboBox x:Name="ThemeCombo" Width="190" HorizontalAlignment="Left" Margin="0,8,0,16"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox><CheckBox x:Name="TopmostPopup" Content="Keep the exercise popup above other windows"/></StackPanel>
      <StackPanel x:Name="AboutPanel" Visibility="Collapsed"><TextBlock Text="About NeckFlow" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Small movement breaks for long hours at your computer." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="15" Margin="0,12,0,18"/><TextBlock Text="NeckFlow provides general mobility reminders and is not medical advice. Move gently within a comfortable range. Stop if you experience pain, dizziness, numbness, weakness, or unusual symptoms." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" LineHeight="20"/></StackPanel>
      <Button Grid.Row="1" Content="Save" Click="SaveClick" Width="120" HorizontalAlignment="Left" Padding="12,9" Margin="0,28,0,0" Background="#2B63C0" Foreground="White" HorizontalContentAlignment="Center"/>
    </Grid></ScrollViewer>
  </Grid>
</Window>
