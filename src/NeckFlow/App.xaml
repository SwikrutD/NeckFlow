  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#5B8DEF"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#F7F8FC"/>
      <SolidColorBrush x:Key="WindowBg" Color="#F7F8FC"/>
    <SolidColorBrush x:Key="TextBrush" Color="#24324A"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#65738A"/>
